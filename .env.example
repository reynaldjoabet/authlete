# Configuration for the Authlete authorization server.
#
# Every name here is read by src/main/resources/application.conf via a ${?VAR} substitution. A
# variable that is not in that file has no effect, however plausible it looks -- keep the two in
# sync when adding one.
#
# Durations are HOCON durations (30s, 10m), not bare numbers. Any value
# containing a space MUST stay quoted: this file is sourced by `make run`, where an unquoted
# `15 seconds` makes the shell try to run `seconds` as a command and leaves the variable empty.

# --- Required. The server refuses to start without these. ---------------------------------

# Numeric service id from the Authlete console.
AUTHLETE_SERVICE_ID=

# Service access token from the Authlete console. A secret: keep it out of version control and
# out of shell history, and inject it from a secret manager in production.
AUTHLETE_SERVICE_ACCESSTOKEN=

# Where the identity provider publishes the keys that sign the access tokens this server accepts.
JWT_JWKS_URI=

# Tokens whose `iss` differs from this are rejected.
JWT_EXPECTED_ISSUER=

# Required and non-empty. A HOCON list or a comma-separated string: "api://one,api://two".
JWT_EXPECTED_AUDIENCE=

# --- Optional. Shown with the defaults from application.conf. ------------------------------

# Authlete cluster: https://us.authlete.com, https://jp.authlete.com, https://eu.authlete.com,
# https://br.authlete.com. Must be the region holding the service above.
AUTHLETE_BASE_URL=https://api.authlete.com/api

AUTHLETE_REQUEST_TIMEOUT=30s

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Must stay below the orchestrator's kill grace period (Kubernetes
# terminationGracePeriodSeconds, default 30s), or the process is killed mid-drain and the
# graceful shutdown never actually runs.
SERVER_SHUTDOWN_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_MAX_CONNECTIONS=1024

# Browser origins allowed to call the protocol endpoints, comma-separated ("*" allows any).
# Required for a browser-based public client (SPA with PKCE); leave empty for confidential clients
# only. The interaction decision callback is never CORS-enabled regardless of this value.
SERVER_CORS_ORIGINS=

JWT_CLOCK_SKEW=60s
JWT_JWKS_TTL=10m

# How long a cached JWKS may still be served while the IdP is unreachable. Trades a window of
# accepting recently-revoked keys for surviving an IdP outage. Must be >= JWT_JWKS_TTL.
JWT_JWKS_MAX_STALE=60m
JWT_FETCH_TIMEOUT=10s

# DPoP proof-of-possession. AUTHLETE_DPOP_KEY is required when this is true; the pairing is
# enforced at startup by AppConfig.validate.
AUTHLETE_DPOP_ENABLED=false
AUTHLETE_DPOP_KEY=

# Certificate for mTLS-bound access tokens, PEM format.
AUTHLETE_CLIENT_CERTIFICATE=

# Header carrying the *client's* certificate, forwarded by whatever terminates TLS (RFC 8705).
# Leave unset unless a trusted proxy both sets this header and strips any copy sent by the caller
# -- otherwise anyone can present it and be authenticated as an mTLS-registered client.
# nginx: X-Ssl-Client-Cert with $ssl_client_escaped_cert. Apache: needs SSLOptions +ExportCertData.
AUTHLETE_CLIENT_CERTIFICATE_HEADER=

# --- Authlete v2 only. Ignored on v3, which authenticates with the token above. -------------
# Setting these on a v3 deployment produces a startup warning.
AUTHLETE_SERVICE_APIKEY=
AUTHLETE_SERVICE_APISECRET=

# --- Interaction application. Optional, but both or neither. --------------------------------
#
# Where the browser is sent when a request needs login or consent; the Authlete ticket is
# appended as a path segment. Must be absolute (scheme and host).
INTERACTION_BASE_URL=

# Bearer credential the interaction application presents when posting a decision back to
# /api/v1/authorization/decision. That callback is what grants consent, so treat this with the
# same care as AUTHLETE_SERVICE_ACCESSTOKEN.
INTERACTION_SHARED_SECRET=
